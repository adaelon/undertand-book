# Understand Book Reader / semantic eval configuration.
# Copy to .env and fill in. Existing environment variables take precedence.
# .env is gitignored. Reading and notes work without a provider; AI answers require all three values.

# Key for your Chat Completions-compatible provider. Do not commit a real key.
OPENCODE_API_KEY=sk-your-key-here

# Base URL as documented by your provider (placeholder, not a live service).
OPENCODE_BASE_URL=https://your-provider.example/v1

# Exact model ID from that provider. Variable name retained by the current runtime.
FLUID_LLM_MODEL=your-model-id

# Optional Resident metadata observability. Keep off unless you intend to send derived metadata.
UB_OBSERVABILITY_MODE=off
# Required only when UB_OBSERVABILITY_MODE=metadata. Do not commit a real key.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=understand-book-dev
# Regional/self-hosted deployments may override this HTTPS origin.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only when one API key is linked to multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Optional filtered Resident spool. Keep it outside book, build-lease, and memory truth sources.
# UB_OBSERVABILITY_SPOOL_DIR=C:\Users\you\AppData\Local\UnderstandBook\observability-spool
# UB_OBSERVABILITY_SPOOL_MAX_BYTES=67108864
# UB_OBSERVABILITY_SPOOL_MAX_FILES=4096
# UB_OBSERVABILITY_SPOOL_RETENTION_HOURS=24
# Target changes default to isolate. Use replay or drop only for an explicit one-time decision.
# UB_OBSERVABILITY_SPOOL_TARGET_CHANGE=isolate
