# Understand Book Reader / semantic eval configuration.
# Copy to .env and fill in. Existing environment variables take precedence.
# .env is gitignored. Reading and notes work without a provider; AI answers require all three values.

# Key for your Chat Completions-compatible provider. Do not commit a real key.
OPENCODE_API_KEY=sk-your-key-here

# Base URL as documented by your provider (placeholder, not a live service).
OPENCODE_BASE_URL=https://your-provider.example/v1

# Exact model ID from that provider. Variable name retained by the current runtime.
FLUID_LLM_MODEL=your-model-id
