{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Reader window capability",
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-codex-plugin-status",
    "allow-install-codex-plugin",
    "allow-set-desktop-library-directory",
    "allow-desktop-provider-status",
    "allow-save-desktop-provider-settings"
  ]
}
