{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Understand Book",
  "version": "0.1.0",
  "identifier": "app.understandbook.reader",
  "build": {
    "beforeBuildCommand": "pnpm -C ../../packages/web build && node scripts/build-sidecar.mjs && node scripts/smoke-workbench-sidecar.mjs && node scripts/prepare-resources.mjs",
    "frontendDist": "../../../packages/web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/understand-book-build"],
    "resources": ["resources/web-dist/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
