UNDERSTAND_BOOK_DIR=/opt/understand-book/books/quickstart-demo
UNDERSTAND_BOOK_LIBRARY_ROOT=/opt/understand-book/books
UNDERSTAND_BOOK_MEMORY_DIR=/opt/understand-book/data/memory
UNDERSTAND_BOOK_PRIVATE_DIR=/opt/understand-book/data/private
UNDERSTAND_BOOK_ADDR=127.0.0.1:8787
UNDERSTAND_BOOK_WEB_DIST=/opt/understand-book/source/packages/web/dist
UNDERSTAND_BOOK_NODE=/opt/understand-book/tools/node-v24.20.0-linux-x64/bin/node
UNDERSTAND_BOOK_PROVIDER=native
# Supply actual Provider values in reader.env on the server.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
FLUID_LLM_MODEL=

# Optional LangSmith metadata projection. Keep credentials in this private systemd EnvironmentFile.
UB_OBSERVABILITY_MODE=off
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=understand-book-reader
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# UB_OBSERVABILITY_SPOOL_DIR=/opt/understand-book/data/observability-spool
# UB_OBSERVABILITY_SPOOL_MAX_BYTES=67108864
# UB_OBSERVABILITY_SPOOL_MAX_FILES=4096
# UB_OBSERVABILITY_SPOOL_RETENTION_HOURS=24
# UB_OBSERVABILITY_SPOOL_TARGET_CHANGE=isolate
